# Modelo das variáveis de ambiente. Copie para .env.local (computador) ou
# cadastre na Vercel em Settings > Environment Variables.

# Conta de serviço do Firebase (projeto estudio-flavio-barbosa).
# Na Vercel: cole o CONTEÚDO inteiro do arquivo .json.
# No computador: pode ser só o caminho do arquivo, ex.: C:/Users/voce/Downloads/arquivo.json
FIREBASE_SERVICE_ACCOUNT=


# Chave do CallMeBot para os avisos no WhatsApp do estúdio.
CALLMEBOT_APIKEY=

# Número que recebe os avisos. Opcional: o padrão é 5511996923040.
CALLMEBOT_PHONE=

# Texto aleatório longo que o cron-job.org envia para /api/cron/lembretes.
CRON_SECRET=

# Opcional: endereço do site com domínio próprio, ex.: https://estudiofb.com.br
# Sem isso, a Vercel informa o endereço sozinha.
SITE_URL=

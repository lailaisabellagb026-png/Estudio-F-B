rules_version = '2';

// Regras do Firestore do Estúdio de Beleza F&B.
//
// O site acessa o banco somente pelo servidor (rotas /api na Vercel), com a
// conta de serviço do Firebase Admin, que não passa por estas regras. Por
// isso nenhum navegador lê nem grava direto no banco: os nomes e telefones
// das clientes ficam protegidos e não existe senha escondida no código do site.
//
// Para publicar: Firebase Console > Firestore Database > Regras > colar > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
